model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DimCustomer","DimCard","DimDate","DimMCC","FactTransaction","FactError","DimRule","KPI_Measures","DataFolder"]

annotation PBI_ProTooling = ["DevMode"]

ref table DimCustomer
ref table DimCard
ref table DimDate
ref table DimMCC
ref table FactTransaction
ref table FactError
ref table DimRule
ref table KPI_Measures

